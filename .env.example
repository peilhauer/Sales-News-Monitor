# Required — powers the LLM signal classifier
ANTHROPIC_API_KEY=

# Optional — enables the NewsAPI.org connector (GDELT works without it)
NEWSAPI_KEY=

# Optional — admin API keys for /refresh and POST /companies, format key:role,key:role
WARN_API_KEYS=warn-dev-key-12345:admin

# Optional — set both to require HTTP Basic Auth on the dashboard/report/companies-read routes
DASHBOARD_USER=
DASHBOARD_PASS=
